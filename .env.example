# Copy to .env and fill in — .env is gitignored, never commit a real token.

# Your Navitia token (required). Request one at https://navitia.io
NAVITIA_API_KEY=

# Coverage region the server is scoped to (optional, default fr-idf).
# fr-idf = Île-de-France, fr-se = southeast/Lyon, sncf = national rail.
NAVITIA_REGION=fr-idf

# API root (optional) — override only for a self-hosted Navitia.
# NAVITIA_BASE_URL=https://api.navitia.io/v1
