{
  "name": "navitia-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the Navitia public transport API (journeys, places, departures, schedules)",
  "type": "module",
  "bin": {
    "navitia-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build:ui",
    "build:ui": "node scripts/build-ui.mjs",
    "typecheck:ui": "tsc -p ui/tsconfig.json",
    "preview:ui": "node scripts/build-ui.mjs --preview",
    "dev": "node scripts/build-ui.mjs && tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "navitia",
    "public-transport",
    "transit",
    "journey-planner"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
